# URL base da API real. Usada quando VITE_USE_MOCK não é "true".
VITE_API_URL=http://localhost:8080/api

# Quando "true", o app usa o backend mock em memória (src/api/mock.ts) e não
# faz nenhuma chamada de rede. Permite desenvolver e validar toda a UI antes
# do backend existir. Deixe vazio ou "false" para consumir a API real.
VITE_USE_MOCK=true
